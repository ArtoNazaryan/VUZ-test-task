NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://squad:squad@localhost:5433/squad_of_champions?schema=public
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://squad:squad@localhost:27017/squad_of_champions?authSource=admin
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
CHARACTERS_JSON_PATH=../frontend/src/data/characters.json
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=info
LOG_PRETTY=true
SWAGGER_ENABLED=true
