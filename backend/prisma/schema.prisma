generator client {
  provider               = "prisma-client"
  output                 = "../src/infrastructure/prisma/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Universe {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  characters Character[]

  @@map("universes")
}

model Character {
  id         Int                @id
  name       String
  quote      String?
  image      String
  thumbnail  String?
  universeId Int                @map("universe_id")
  universe   Universe           @relation(fields: [universeId], references: [id])
  tags       CharacterTag[]
  abilities  CharacterAbility[]
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "characters_name_trgm_idx")
  @@index([universeId])
  @@map("characters")
}

model Tag {
  id         Int            @id @default(autoincrement())
  name       String         @unique
  characters CharacterTag[]

  @@map("tags")
}

model CharacterTag {
  characterId Int       @map("character_id")
  tagId       Int       @map("tag_id")
  slot        Int       @db.SmallInt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([characterId, tagId])
  @@index([tagId])
  @@map("character_tags")
}

model Ability {
  id         Int                @id @default(autoincrement())
  name       String             @unique
  characters CharacterAbility[]

  @@map("abilities")
}

model CharacterAbility {
  characterId Int       @map("character_id")
  abilityId   Int       @map("ability_id")
  score       Int       @db.SmallInt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  ability     Ability   @relation(fields: [abilityId], references: [id])

  @@id([characterId, abilityId])
  @@map("character_abilities")
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
